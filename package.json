{
  "name": "twinny",
  "version": "0.1.0",
  "description": "Bridge Lark p2p messages to per-profile Codex app-server threads.",
  "type": "module",
  "bin": {
    "twinny": "dist/main.js"
  },
  "files": [
    "dist",
    "migrations",
    "configs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.52.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.3.1",
    "undici": "^7.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
