{
  "name": "twinny",
  "version": "0.0.0-dev.0",
  "description": "Local Feishu/Lark-to-Codex bridge with per-profile Codex agent threads.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "twinny": "dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hachiwii/twinny.git"
  },
  "bugs": {
    "url": "https://github.com/hachiwii/twinny/issues"
  },
  "homepage": "https://github.com/hachiwii/twinny#readme",
  "keywords": [
    "codex",
    "feishu",
    "lark",
    "agent",
    "bridge",
    "cli"
  ],
  "files": [
    "dist",
    "migrations",
    "configs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "prepack": "node scripts/build.mjs --version $npm_package_version",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "release:dry-run": "npm pack --dry-run --registry https://registry.npmjs.org",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.52.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "lru-cache": "^11.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "posthog-node": "^5.13.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.3.1",
    "undici": "^7.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
